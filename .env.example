# Copy to .env and fill in. .env is gitignored and must never be committed.

# Razorpay TEST mode keys. Dashboard -> Account & Settings -> API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dedicated test-mode webhook signing secret. It is not either API key.
RAZORPAY_WEBHOOK_SECRET=

# Shared secret every HTTP caller must present as `Authorization: Bearer <token>`.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RESERVE_GATE_TOKEN=

# The operator's secret, for POST /approve, POST /revoke, POST /unfreeze and
# GET /block. It has to be different from the token above and the buyer agent
# must never be given it: the agent needs RESERVE_GATE_TOKEN to make a call at
# all, so one shared secret would let it approve its own spending.
RESERVE_GATE_ADMIN_TOKEN=

# Only for `python -m src.buyer --llm`. Not needed for the tests or --scripted.
GEMINI_API_KEY=
# Optional. Overrides the buyer's default when a model id retires.
GEMINI_MODEL=
