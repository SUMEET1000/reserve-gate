# Secrets
.env
.env.*
!.env.example
*.pem

# Local ledger and working audit log. A curated sample is committed instead.
audit.jsonl
audit-test.jsonl
perf_check.jsonl
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/
*.egg-info/

# Working notes and planning. This repo is public: project files only.
Handoff/
*HANDOFF*.md
*BUILDPLAN*.md
NOTES.md
PROGRESS.md
PRODUCT.md
IDEAS.md
TODO.md
submission-answers.md
plan-gaps.md
redteam-findings.md
PLANS/
scratch/

# Front-end toolchain. web/app.js and web/app.css are the build output and are
# committed on purpose: Render's build command is pip only, and a judge running
# the three-command repro has no npm step.
frontend/node_modules/
frontend/.vite/

# Editor and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

.graphifyignore

# graphify knowledge-graph output. Generated, and graph.json embeds file
# content — the Stop hook rebuilds it for free, so never commit it.
graphify-out/

# Per-agent config. One directory per coding agent, all of it local machine
# state — hooks with absolute Windows paths, and skill copies that belong in
# the user-level skills folder, not in a public repo.
.claude/
.codex/
.agents/

# Linter caches and config. qlty and ruff each write a self-ignoring
# .gitignore, but qlty's re-includes qlty.toml — excluding the directory here
# overrides that, since git never descends into an excluded parent.
.qlty/
.ruff_cache/

.playwright/
.playwright-cli/

# One-off page-audit scripts and their output, written into frontend/ by
# browsing sessions. run_audit.mjs imports playwright through an absolute path
# into this machine's global npm folder, so it is not runnable anywhere else,
# and audit_results.json is that run's output rather than a source file.
frontend/run_audit.mjs
frontend/audit_deep.mjs
frontend/audit_results.json

.impeccable/

# The design journal, private like PROGRESS.md and IDEAS.md.
DESIGN_PROGRESS.md

# Review screenshots and playwright-cli accessibility snapshots, written to the
# repo root by browsing sessions. Scratch: the site loads none of them.
/*.png
/*.yml
!/render.yaml

# Design inputs, not shipped assets. references/ holds third-party poster art
# used only to pick a direction, and this repo is public; assets/mumbai.png is
# referenced by nothing. The direction contract cites references/creation.jpg
# in a comment, which needs no file.
references/
assets/


# Local snapshots of the private files above, taken before a risky edit. Dated,
# so the glob covers the next one too.
.private-backup-*/
